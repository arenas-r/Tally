
<div class="container-fluid">
    <h1 class="mb-4 text-primary">Dashboard</h1>
    <p>Welcome to Tally!</p>

    <div class="row row-cols-1 row-cols-lg-3 g-4 mt-3">

        <div class="col">
            <div class="card h-100 shadow-sm rounded-3">
                <div class="card-body">
                    <h5 class="card-title">Upcoming Assignments</h5>
                    <h6 class="card-subtitle mb-2 text-body-secondary">Due Soon</h6>

                    <ul class="list_group">
                        {{#each assignments}}
                            <li class="list-group-item d-flex justify-content-between
                            align-items-center">
                                {{this.assignment_name}}
                                <span class="badge text-bg-secondary">
                                    {{this.priority}}
                                </span>
                            </li>
                        {{/each}}
                    </ul>

                    <a href="/calendar" class="card-link">View Calendar</a>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm rounded-3">
                <div class="card-body">
                    <h5 class="card-title">Weekly Workload</h5>
                    <h6 class="card-subtitle mb-2 text-body-secondary">This Week</h6>

                    <p class="card-text">Track your assignment completion this week.</p>

                    <div class="progress mb-3"
                         role="progressbar"
                         aria-label="Weekly assignment completion"
                         aria-valuenow="25"
                         aria-valuemin="0"
                         aria-valuemax="100">
                        <div class="progress-bar" style="width: 25%">
                            25%
                        </div>
                    </div>

                    <a href="/path" class="card-link">View Study Path</a>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm rounded-3">
                <div class="card-body">
                    <h5 class="card-title">My Courses</h5>
                    <h6 class="card-subtitle mb-2 text-body-secondary">Enrolled Courses</h6>

                    <ul class="list-group">
                        {{#each courses}}
                            <li class="list-group-item d-flex justify-content-between
                            align-items-center">
                                {{this.course_name}}
                                <span class="badge text-bg-secondary">
                                    {{this.course_code}}
                                </span>
                            </li>
                        {{else}}
                            <li class="list-group-item">
                                No courses added yet
                            </li>
                        {{/each}}
                    </ul>

                    <a href="/courses" class="card-link">View Courses</a>
                </div>
            </div>
        </div>

    </div>
</div>
