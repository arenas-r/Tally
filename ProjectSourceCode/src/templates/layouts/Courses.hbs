<div class="container py-4">

    <div class="row g-4">
        {{#each courses}}
            <div class="col-12 col-sm-6 col-md-4 col-lg-3">

                <a href="/courses/{{course_id}}"
                   class="text-decoration-none text-dark">

                    <div class="card h-100 shadow-sm">

                        <!-- Course Image -->
                        <img
                            src="{{image}}"
                            class="card-img-top"
                            alt="{{course_name}}"
                            style="height: 180px; object-fit: cover;"
                        >

                        <!-- Course Footer -->
                        <div class="card-footer bg-white border-0 py-3">
                            <h5 class="card-title mb-1">
                                {{course_name}}
                            </h5>

                            <p class="card-text text-muted mb-0">
                                {{course_code}}
                            </p>
                        </div>

                    </div>

                </a>

            </div>
        {{/each}}
    </div>


    {{#if selectedCourse}}

        <div class="mt-5">

            <h3>{{selectedCourse.course_name}}</h3>

            <p class="text-muted">
                {{selectedCourse.course_code}}
            </p>

            <!-- Collapse Button -->
            <button
                class="btn btn-outline-secondary"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#upcomingAssignments"
                aria-expanded="false"
                aria-controls="upcomingAssignments"
            >
                Upcoming Assignments
            </button>


            <!-- Collapsible Assignments -->
            <div class="collapse mt-3" id="upcomingAssignments">

                {{#each assignments}}

                    <div class="card mb-2 shadow-sm">
                        <div class="card-body">

                            <h6 class="card-title mb-1">
                                {{assignment_name}}
                            </h6>

                            <p class="card-text text-muted mb-1">
                                Due: {{due_date}}
                            </p>

                            {{#if description}}
                                <p class="card-text">
                                    {{description}}
                                </p>
                            {{/if}}

                        </div>
                    </div>

                {{else}}

                    <p class="text-muted">
                        No upcoming assignments.
                    </p>

                {{/each}}

            </div>

        </div>

    {{/if}}

</div>