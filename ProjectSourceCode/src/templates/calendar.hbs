
<div class="calendar-page">

    <!-- Assignment error notifications -->
    <div
        id="assignment-toast"
        class="assignment-toast"
        role="alert"
        hidden>
    </div>

    <div class="calendar-buttons">
        <!-- Show or hide the assignment form -->
        <button
            type="button"
            id="add-assignment-button"
            onclick="toggleForms('assignment')">
            + Add Assignment
        </button>

        <!-- Show or hide the import form -->
        <button
            type="button"
            id="import-calendar-button"
            onclick="toggleForms('import')">
            + Import Calendar
        </button>
    </div>

    <!-- Form for adding new assignments -->
    <div id="assignment-form-container" hidden>
        <h2>New Assignment</h2>

        <form
            id="new-assignment-form"
            action="/calendar/add"
            method="POST">

            <!-- Course selection -->
            <label for="course_id">Course</label>
            <select id="course_id" name="course_id" required>
                <option value="" selected disabled>
                    Select a Course
                </option>

                {{#each courses}}
                    <option value="{{course_id}}">
                        {{course_code}} - {{course_name}}
                    </option>
                {{/each}}
            </select>

            <!-- Assignment information -->
            <label for="assignment_name">Assignment Name</label>
            <input
                type="text"
                id="assignment_name"
                name="assignment_name"
                maxlength="150"
                required
            >

            <label for="description">Description</label>
            <textarea
                id="description"
                name="description"
                rows="3"
            ></textarea>

            <label for="due_date">Due Date and Time</label>
            <input
                type="datetime-local"
                id="due_date"
                name="due_date"
                required
            >

            <label for="priority">Priority</label>
            <select id="priority" name="priority">
                <option value="">No Priority</option>
                <option value="low">Low</option>
                <option value="medium">Medium</option>
                <option value="high">High</option>
            </select>

            <label for="estimated_time">
                Estimated Time (minutes)
            </label>
            <input
                type="number"
                id="estimated_time"
                name="estimated_time"
                min="0"
            >


            <!-- Optional assignment attachments -->
            <label for="new-assignment-files">
                Assignment Files (Optional)
            </label>

            <input
                type="file"
                id="new-assignment-files"
                name="assignment_files"
                accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.rtf,.png,.jpg,.jpeg"
                multiple
            >

            <p class="attachment-help">
                Attach PDF, Word, Excel, PowerPoint, text, or image files.
                Maximum 10 MB per file.
            </p>


            <button type="submit">
                Save Assignment
            </button>

        </form>
    </div>

    <!-- Form for importing calendars -->
    <div id="import-calendar-form-container" hidden>
        <h2>Import Calendar</h2>

        <form id="import-calendar-form"
            action="/import/icalSubmission" 
            method="POST" 
            enctype="multipart/form-data">
                <input type="file" name="icalFile" accept=".ics, .ical">
                <button type="submit">Upload</button>
        </form>
    </div>

    <!-- Calendar header and month navigation -->
    <header class="calendar-header">
        <h1>Calendar</h1>

        <div class="calendar-navigation">
            <a href="/calendar?month={{previousMonth}}">
                ← Previous
            </a>

            <h2>{{monthLabel}}</h2>

            <a href="/calendar?month={{nextMonth}}">
                Next →
            </a>
        </div>
    </header>

    <!-- Days of the week -->
    <div class="calendar-weekdays">
        <div>Sun</div>
        <div>Mon</div>
        <div>Tue</div>
        <div>Wed</div>
        <div>Thu</div>
        <div>Fri</div>
        <div>Sat</div>
    </div>

    <!-- Calendar days and assignments -->
    <div class="calendar-grid">

        {{#each days}}

            {{#if isBlank}}

                <!-- Blank days before the month starts -->
                <div class="calendar-day blank"></div>

            {{else}}

                <div class="calendar-day">

                    <div class="day-number">
                        {{day}}
                    </div>

                    <!-- Clickable assignments with details stored in data attributes -->
                    {{#each assignments}}

                        <button
                            type="button"
                            class="calendar-assignment {{priority}}"
                            data-id="{{assignment_id}}"
                            data-name="{{assignment_name}}"
                            data-course="{{course_code}} {{course_name}}"
                            data-date="{{due_day}}"
                            data-time="{{due_time}}"
                            data-description="{{description}}"
                            data-priority="{{priority}}"
                            data-estimated="{{estimated_time}}"
                            data-completed="{{completed}}"
                            onclick="openAssignmentDetails(this)">

                            <strong>{{assignment_name}}</strong>

                            <span>
                                {{course_code}} {{course_name}}
                            </span>

                            <span>
                                {{due_time}}
                            </span>

                        </button>

                    {{/each}}

                </div>

            {{/if}}

        {{/each}}

    </div>

</div>

<!-- Assignment details pop-up -->
<dialog
    id="assignment-details-dialog"
    aria-labelledby="details-name">

    <h2 id="details-name"></h2>

    <p id="details-course"></p>

    <!-- Assignment information -->
    <p>
        <strong>Due Date:</strong>
        <span id="details-due"></span>
    </p>

    <p>
        <strong>Description:</strong>
        <span id="details-description"></span>
    </p>

    <p>
        <strong>Priority:</strong>
        <span id="details-priority"></span>
    </p>

    <p>
        <strong>Estimated Time:</strong>
        <span id="details-estimated"></span>
    </p>

    <!-- Update assignment completion -->
    <label for="details-completed">
        <input
            type="checkbox"
            id="details-completed"
        >
        Completed
    </label>

    <!-- Show an error if the completion update fails -->
    <p id="completion-error" role="alert" hidden>
        Unable to update completion status. Please try again.
    </p>


<!-- Assignment file attachments -->
<section id="assignment-attachments" aria-labelledby="attachments-heading">

    <h3 id="attachments-heading">Attachments</h3>

    <p class="attachment-help">
        Upload PDF, Word, Excel, PowerPoint, text, or image files.
        Maximum file size: 10 MB.
    </p>

    <form id="attachment-upload-form">
        <label for="attachment-file">Choose a file</label>

        <input
            type="file"
            id="attachment-file"
            name="attachment"
            accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.rtf,.png,.jpg,.jpeg"
            required
        >

        <button type="submit" id="attachment-upload-button">
            Upload File
        </button>
    </form>

    <p id="attachment-message" role="status" aria-live="polite"></p>

    <h4>Uploaded Files</h4>
    <ul id="attachment-list"></ul>

</section>


    <!-- Close the details pop-up -->
    <button
        type="button"
        id="close-details-button"
        onclick="document.getElementById('assignment-details-dialog').close()">
        Close
    </button>

</dialog>

<script>

    // Track the assignment currently being viewed
    let selectedAssignment = null;

    // Show or hide the assignment and import form
    function toggleForms(form) {
        const assignmentContainer = document.getElementById("assignment-form-container");
        const importContainer = document.getElementById("import-calendar-form-container");

        switch(form) {
            case "assignment":
                if (!importContainer.hidden) {
                    importContainer.hidden = !importContainer.hidden;
                }

                assignmentContainer.hidden = !assignmentContainer.hidden;
                break;
            case "import":
                if (!assignmentContainer.hidden) {
                    assignmentContainer.hidden = !assignmentContainer.hidden;
                }

                importContainer.hidden = !importContainer.hidden;
                break;
        }
    }

    
    function showToast(message, type = "error") {
        const toast = document.getElementById("assignment-toast");

        toast.textContent = message;
        toast.classList.toggle("success", type === "success");
        toast.hidden = false;

        clearTimeout(window.assignmentToastTimer);

        window.assignmentToastTimer = setTimeout(() => {
            toast.hidden = true;
        }, 10000);
    }


// Show the result of creating an assignment.
const noticeParams = new URLSearchParams(window.location.search);
const notice = noticeParams.get("notice");

if (notice === "created") {
    showToast("Assignment created successfully!", "success");
}

if (notice === "created-uploaded") {
    showToast(
        "Assignment created and all files uploaded successfully!",
        "success"
    );
}

if (notice === "created-upload-warning") {
    showToast(
        "Assignment created, but one or more files failed to upload. Open the assignment to retry."
    );
}

// Remove the notification parameter so refreshing does not repeat it.
if (notice) {
    const cleanUrl = new URL(window.location.href);
    cleanUrl.searchParams.delete("notice");

    window.history.replaceState(
        {},
        "",
        cleanUrl.pathname + cleanUrl.search
    );
}

    
// Create an assignment, then upload any selected attachments.
const form = document.getElementById("new-assignment-form");

form.addEventListener("submit", async function(event) {
    event.preventDefault();

    const saveButton = form.querySelector('button[type="submit"]');
    const originalButtonText = saveButton.textContent;
    const fileInput = document.getElementById("new-assignment-files");
    const selectedFiles = Array.from(fileInput.files);

    // Match the backend's 10 MB per-file limit.
    const MAX_FILE_SIZE = 10 * 1024 * 1024;

    for (const file of selectedFiles) {
        if (file.size > MAX_FILE_SIZE) {
            showToast(`${file.name} exceeds the 10 MB file limit.`);
            return;
        }
    }

    saveButton.disabled = true;
    saveButton.textContent = "Creating assignment...";

    try {
        // Only send text fields to /calendar/add.
        const assignmentData = new FormData(form);
        assignmentData.delete("assignment_files");

        const createResponse = await fetch("/calendar/add", {
            method: "POST",
            headers: {
                "Accept": "application/json"
            },
            body: new URLSearchParams(assignmentData)
        });

        if (createResponse.status === 409) {
            showToast("This assignment already exists.");
            return;
        }

        if (!createResponse.ok) {
            throw new Error(
                "Unable to create assignment. Check the form and try again."
            );
        }

        const created = await createResponse.json();

        if (!created.assignmentId || !created.redirectUrl) {
            throw new Error("The server did not return an assignment ID.");
        }

        let failedUploads = 0;

        // Upload files individually using the existing S3 route.
        for (const file of selectedFiles) {
            saveButton.textContent = `Uploading ${file.name}...`;

            const uploadData = new FormData();
            uploadData.append("attachment", file);

            try {
                const uploadResponse = await fetch(
                    `/calendar/${encodeURIComponent(created.assignmentId)}/files`,
                    {
                        method: "POST",
                        body: uploadData
                    }
                );

                if (!uploadResponse.ok) {
                    failedUploads++;
                    console.error(
                        "File upload failed:",
                        file.name,
                        uploadResponse.status
                    );
                }

            } catch (uploadError) {
                failedUploads++;
                console.error(
                    `Error uploading ${file.name}:`,
                    uploadError
                );
            }
        }

        // Navigate to the month containing the new assignment.
        const redirectUrl = new URL(
            created.redirectUrl,
            window.location.origin
        );

        // Preserve a notification after the page reload.
        if (failedUploads > 0) {
            redirectUrl.searchParams.set(
                "notice",
                "created-upload-warning"
            );
        } else if (selectedFiles.length > 0) {
            redirectUrl.searchParams.set(
                "notice",
                "created-uploaded"
            );
        } else {
            redirectUrl.searchParams.set(
                "notice",
                "created"
            );
        }

        window.location.assign(
            redirectUrl.pathname + redirectUrl.search
        );

    } catch (error) {
        console.error("Assignment creation error:", error);
        showToast(error.message || "Unable to create assignment.");

    } finally {
        saveButton.disabled = false;
        saveButton.textContent = originalButtonText;
    }
});

    // Fill and open the assignment details pop-up
    function openAssignmentDetails(assignment) {
        const data = assignment.dataset;

        selectedAssignment = assignment;

        // Clear previous errors
        document.getElementById("completion-error").hidden = true;

        // Display the selected assignment's information
        document.getElementById("details-name").textContent =
            data.name;

        document.getElementById("details-course").textContent =
            data.course;

        document.getElementById("details-due").textContent =
            `${data.date} at ${data.time}`;

        document.getElementById("details-description").textContent =
            data.description || "No description provided";

        document.getElementById("details-priority").textContent =
            data.priority || "Not specified";

        document.getElementById("details-estimated").textContent =
            data.estimated ? `${data.estimated} minutes` : "Not specified";

        // Load the saved completion status
        document.getElementById("details-completed").checked =
            data.completed === "true";

        document.getElementById("attachment-upload-form").reset();
        document.getElementById("attachment-message").textContent = "";

        document.getElementById("assignment-details-dialog").showModal();

        loadAssignmentFiles(data.id);
    }

    // Save completion changes to the server
    const completionCheckbox =
        document.getElementById("details-completed");

    completionCheckbox.addEventListener("change", async function() {

        // Get the selected assignment and checkbox value
        const assignment = selectedAssignment;
        const assignmentId = assignment.dataset.id;
        const completed = completionCheckbox.checked;

        const errorMessage =
            document.getElementById("completion-error");

        // Disable the checkbox while saving
        errorMessage.hidden = true;
        completionCheckbox.disabled = true;

        try {
            const response = await fetch(
                `/calendar/${assignmentId}/completed`,
                {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/x-www-form-urlencoded"
                    },
                    body: new URLSearchParams({
                        completed: String(completed)
                    })
                }
            );

            // Check if the update succeeded
            if (!response.ok) {
                throw new Error("Unable to update assignment");
            }

            const updatedAssignment = await response.json();

            // Update the assignment's stored status
            assignment.dataset.completed =
                String(updatedAssignment.completed);

        } catch (error) {
            console.error("Completion update error:", error);

            // Restore the old status if saving fails
            if (selectedAssignment === assignment) {
                completionCheckbox.checked =
                    assignment.dataset.completed === "true";

                errorMessage.hidden = false;
            }

        } finally {
            // Re-enable the checkbox after saving
            if (selectedAssignment === assignment) {
                completionCheckbox.disabled = false;
            }
        }
    });

// Retrieve and display files attached to the selected assignment.
async function loadAssignmentFiles(assignmentId) {
    const list = document.getElementById("attachment-list");
    const message = document.getElementById("attachment-message");

    list.replaceChildren();
    message.textContent = "";

    const loading = document.createElement("li");
    loading.textContent = "Loading attachments...";
    list.appendChild(loading);

    try {
        const response = await fetch(
            `/calendar/${encodeURIComponent(assignmentId)}/files`
        );

        const result = await response.json();

        if (!response.ok) {
            throw new Error(result.error || "Unable to load attachments.");
        }

        // Ignore an old request if the user opened another assignment.
        if (selectedAssignment?.dataset.id !== String(assignmentId)) {
            return;
        }

        list.replaceChildren();

        if (result.files.length === 0) {
            const empty = document.createElement("li");
            empty.textContent = "No files uploaded yet.";
            list.appendChild(empty);
            return;
        }

        result.files.forEach(file => {
            const item = document.createElement("li");

            const link = document.createElement("a");
            link.href =
                `/calendar/${encodeURIComponent(assignmentId)}` +
                `/files/${encodeURIComponent(file.fileId)}/download`;

            link.textContent = file.name;

            const size = document.createElement("span");
            size.className = "attachment-size";
            size.textContent =
                ` (${Math.ceil(file.size / 1024)} KB)`;

            item.appendChild(link);
            item.appendChild(size);
            list.appendChild(item);
        });

    } catch (error) {
        if (selectedAssignment?.dataset.id === String(assignmentId)) {
            list.replaceChildren();
            message.textContent = error.message;
        }
    }
}


// Upload a file without reloading the calendar.
const attachmentForm =
    document.getElementById("attachment-upload-form");

attachmentForm.addEventListener("submit", async function(event) {
    event.preventDefault();

    const assignmentId = selectedAssignment?.dataset.id;
    const message = document.getElementById("attachment-message");
    const uploadButton =
        document.getElementById("attachment-upload-button");

    if (!assignmentId) {
        message.textContent = "Please select an assignment.";
        return;
    }

    uploadButton.disabled = true;
    message.textContent = "Uploading file...";

    try {
        const formData = new FormData(attachmentForm);

        const response = await fetch(
            `/calendar/${encodeURIComponent(assignmentId)}/files`,
            {
                method: "POST",
                body: formData
            }
        );

        const result = await response.json();

        if (!response.ok) {
            throw new Error(result.error || "File upload failed.");
        }

        attachmentForm.reset();

        await loadAssignmentFiles(assignmentId);

        if (selectedAssignment?.dataset.id === String(assignmentId)) {
            message.textContent = "File uploaded successfully.";
        }

    } catch (error) {
        message.textContent = error.message;

    } finally {
        uploadButton.disabled = false;
    }
});

</script>
