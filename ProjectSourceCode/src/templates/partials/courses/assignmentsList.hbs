<div class="assignments-list">

    {{#each assignments}}

        <div class="assignment-card">

            <div class="assignment-top-row">

                <div>
                    <h6 class="assignment-name">
                        {{assignment_name}}
                    </h6>

                    <p class="assignment-due" 
                        data-due-date="{{due_date}}">
                        Due <span class="formatted-due-date"></span>
                    </p>
                </div>

                {{#if overdue}}
                    <span class="assignment-status overdue">
                        Overdue
                    </span>
                {{else}}
                    <span class="assignment-status">
                        Upcoming
                    </span>
                {{/if}}

            </div>

            {{#if description}}
                <p class="assignment-description">
                    {{description}}
                </p>
            {{/if}}

        </div>

    {{else}}

        <p class="assignments-empty">
            No pending assignments.
        </p>

    {{/each}}

</div>