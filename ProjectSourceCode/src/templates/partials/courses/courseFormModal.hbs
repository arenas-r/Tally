<div
    class="modal fade"
    id="{{#if course}}editCourseModal-{{course.course_id}}{{else}}addCourseModal{{/if}}"
    tabindex="-1"
    aria-hidden="true"
>
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content add-course-modal">

            <div class="modal-header">
                <div>
                    <h5 class="modal-title">
                        {{#if course}}Edit Course{{else}}Add Course{{/if}}
                    </h5>

                    <p class="modal-subtitle">
                        {{#if course}}
                            Update your course information.
                        {{else}}
                            Create a new course to track assignments.
                        {{/if}}
                    </p>
                </div>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                    aria-label="Close"
                ></button>
            </div>

            <form
                action="{{#if course}}/courses/{{course.course_id}}/edit{{else}}/courses{{/if}}"
                method="POST"
            >
                <div class="modal-body">

                    <div class="mb-3">
                        <label class="form-label">
                            Course Name
                        </label>

                        <input
                            type="text"
                            name="course_name"
                            class="form-control"
                            placeholder="Introduction to Computer Science"
                            value="{{course.course_name}}"
                            maxlength="100"
                            required
                        >
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Course Code
                        </label>

                        <input
                            type="text"
                            name="course_code"
                            class="form-control"
                            placeholder="CSCI 1300"
                            value="{{course.course_code}}"
                            maxlength="10"
                            required
                        >
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Image URL
                            <span class="text-muted">(Optional)</span>
                        </label>

                        <input
                            type="url"
                            name="image"
                            class="form-control"
                            placeholder="https://example.com/image.jpg"
                            value="{{course.image}}"
                        >
                    </div>

                </div>

                <div class="modal-footer">
                    <button
                        type="button"
                        class="btn btn-light"
                        data-bs-dismiss="modal"
                    >
                        Cancel
                    </button>

                    <button type="submit" class="add-course-btn">
                        {{#if course}}Save Changes{{else}}Create Course{{/if}}
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>