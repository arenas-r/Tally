
<div class="row g-4">

    {{#each courses}}
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
            {{> courses/courseCard course=this}}
        </div>
    {{else}}
        <div class="col-12">
            <p class="text-muted">
                No courses found.
            </p>
        </div>
    {{/each}}

</div>
