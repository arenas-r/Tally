<!-- <link rel="stylesheet" href=".css"> -->
<link rel="stylesheet" href="/styles/path.css">
<!-- Outer Container / Card Box -->
<div class="path-structure">
    {{#each assignment}}
<!-- Outer Container / Card Box -->
    <div class="node-card">
    <!-- Node Content Inside -->
    <!--Place Holder for {each}, need to loop-->
        <button type="button" class="collapsible">
            <span class="node-assignment">{{assignment_name}}</span>
            <span class="card-text text-muted mb-2">📅 {{due_date}}</span>
        </button>
        
        <div class = "content">
            <!--Can add feature later to add different filters-->
            <p class="node-priority">Priority: {{priority}}</p>
            <!--Can add completion status that makes this dissapear and go into the compelted section or something-->        
            <p class="node-status">Status: {{completed}}</p>
            <p class="node-time">Estimated Time: {{estimated_time}}</p>
            <p class="node-descriptions">Description: {{description}}</p>        
        </div>
    </div>
    {{/each}}
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {    
        const collapsibles = document.querySelectorAll(".collapsible");
        
        collapsibles.forEach(button=>{
            button.addEventListener("click",function(){
                const card = this.closest(".node-card");
                card.classList.toggle("active");
            });
        });
    });
</script>